+template <int warp_size, int scan_wg>
+static void flash_attn_mask_to_KV_bounds(const sycl::half2 * __restrict__ mask,
+                                         int * __restrict__ KV_bounds,
+                                         const int ne30,
+                                         const int s31,
+                                         const int s33) {
+    static_assert(scan_wg % warp_size == 0, "scan work-group must contain full subgroups");
+
+    auto      item_ct1 = sycl::ext::oneapi::this_work_item::get_nd_item<3>();
+    const int ne31     = item_ct1.get_group_range(2);
+    const int tid      = item_ct1.get_local_id(2);
+    const int sequence = item_ct1.get_group(1);
+    const int jt       = item_ct1.get_group(2);
+
+    mask += sequence * s33 + jt * s31;
+
+    int KV_max_sj = (ne30 - 1) * FATTN_KQ_STRIDE;
+    for (; KV_max_sj >= 0; KV_max_sj -= FATTN_KQ_STRIDE) {
+        bool all_inf = true;
+        if (tid < FATTN_KQ_STRIDE / 2) {
+            const sycl::float2 cur =
+                mask[KV_max_sj / 2 + tid].template convert<float, sycl::rounding_mode::automatic>();
+            all_inf = sycl::isinf((float) cur.x()) && sycl::isinf((float) cur.y());
+        }
+        all_inf = sycl::all_of_group(item_ct1.get_group(), all_inf);
+        if (!all_inf) {
+            break;
+        }
+    }
+    KV_max_sj += FATTN_KQ_STRIDE;
+
+    int KV_min_sj = 0;
+    if (KV_max_sj > 0) {
+        int first_finite = FATTN_KQ_STRIDE;
+        if (tid < FATTN_KQ_STRIDE / 2) {
+            const sycl::float2 first =
+                mask[tid].template convert<float, sycl::rounding_mode::automatic>();
+            const bool first_x_inf = sycl::isinf((float) first.x());
+            const bool first_y_inf = sycl::isinf((float) first.y());
+            first_finite = !first_x_inf ? 2 * tid : (!first_y_inf ? 2 * tid + 1 : FATTN_KQ_STRIDE);
+        }
+        first_finite = sycl::reduce_over_group(
+            item_ct1.get_group(), first_finite, sycl::minimum<int>());
+
+        if (first_finite == FATTN_KQ_STRIDE) {
+            first_finite = KV_max_sj;
+            for (int ih = FATTN_KQ_STRIDE / 2 + tid;
+                 ih < KV_max_sj / 2;
+                 ih += scan_wg) {
+                const sycl::float2 cur =
+                    mask[ih].template convert<float, sycl::rounding_mode::automatic>();
+                const bool x_inf = sycl::isinf((float) cur.x());
+                const bool y_inf = sycl::isinf((float) cur.y());
+                if (!x_inf || !y_inf) {
+                    first_finite = 2 * ih + (x_inf ? 1 : 0);
+                    break;
+                }
+            }
+            first_finite = sycl::reduce_over_group(
+                item_ct1.get_group(), first_finite, sycl::minimum<int>());
+            KV_min_sj = (first_finite / FATTN_KQ_STRIDE) * FATTN_KQ_STRIDE;
+        }
+    }
+
+    if (tid == 0) {
+        const int ib = sequence * ne31 + jt;
+        KV_bounds[2 * ib + 0] = KV_min_sj;
+        KV_bounds[2 * ib + 1] = KV_max_sj;
+    }
 }
 
