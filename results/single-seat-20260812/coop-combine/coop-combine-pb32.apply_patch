         const dpct::dim3 block_dim_combine(DV, 1, 1);
         const dpct::dim3 blocks_num_combine(Q->ne[1], Q->ne[2], Q->ne[3]);
         const size_t     nbytes_shared_combine = parallel_blocks * sizeof(sycl::float2);
