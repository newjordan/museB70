+
+        // Opt-in only, and deliberately narrower than the generic combine:
+        // D=128 at compile time, PB=32 and single-token decode at runtime.
+        static const bool lx_fattn_coop_combine_pb32 = []() {
+            const char * e = getenv("GGML_SYCL_LX_FATTN_COOP_COMBINE_PB32");
+            return e != nullptr && e[0] != '\0' && e[0] != '0';
+        }();
+
+        bool submitted_cooperative = false;
+        if constexpr (DV == 128) {
+            if (lx_fattn_coop_combine_pb32 && parallel_blocks == 32 && Q->ne[1] == 1) {
+                constexpr int lx_parallel_blocks = 32;
+                main_stream->submit([&](sycl::handler & cgh) {
+                    // A float accessor supplies proper float alignment; the two
+                    // 32-float regions do not alias.
+                    sycl::local_accessor<float, 1> shared_acc_ct1(sycl::range<1>(2*lx_parallel_blocks), cgh);
+
+                    auto dst_tmp_ptr_ct0      = dst_tmp.ptr;
+                    auto dst_tmp_meta_ptr_ct1 = dst_tmp_meta.ptr;
+                    auto KQV_data_ct2         = (float *) KQV->data;
+
+                    cgh.parallel_for(sycl::nd_range<3>(blocks_num_combine * block_dim_combine, block_dim_combine),
+                                     [=](sycl::nd_item<3> item_ct1) [[sycl::reqd_sub_group_size(warp_size)]] {
+                                         GGML_UNUSED(item_ct1);
+                                         flash_attn_combine_results_cooperative_pb32_d128(
+                                             dst_tmp_ptr_ct0, dst_tmp_meta_ptr_ct1, KQV_data_ct2,
+                                             shared_acc_ct1.get_multi_ptr<sycl::access::decorated::no>().get());
+                                     });
+                });
+                submitted_cooperative = true;
+            }
+        }
+
+        if (!submitted_cooperative) {
+            // Exact pre-existing device path for gate-off and all unsupported
+            // shapes/parallel widths.
+            main_stream->submit([&](sycl::handler & cgh) {
+                sycl::local_accessor<uint8_t, 1> dpct_local_acc_ct1(sycl::range<1>(nbytes_shared_combine), cgh);
+
+                auto dst_tmp_ptr_ct0      = dst_tmp.ptr;
+                auto dst_tmp_meta_ptr_ct1 = dst_tmp_meta.ptr;
+                auto KQV_data_ct2         = (float *) KQV->data;
+
+                cgh.parallel_for(sycl::nd_range<3>(blocks_num_combine * block_dim_combine, block_dim_combine),
+                                 [=](sycl::nd_item<3> item_ct1) [[sycl::reqd_sub_group_size(warp_size)]] {
+                                     GGML_UNUSED(item_ct1);
+                                     flash_attn_combine_results<DV>(
+                                         dst_tmp_ptr_ct0, dst_tmp_meta_ptr_ct1, KQV_data_ct2, parallel_blocks,
+                                         dpct_local_acc_ct1.get_multi_ptr<sycl::access::decorated::no>().get());
+                                 });
+            });
+        }
     }
     SYCL_CHECK(0);
